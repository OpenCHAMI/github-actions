{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>OpenCHAMI/.github//renovate-config/default",
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default renovate-config-validator version in lint-renovate and its README example",
      "managerFilePatterns": [
        "/^\\.github/workflows/lint-renovate\\.yml$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "renovate-version:\\s*\\n(?:\\s+[a-z]+:.*\\n)*?\\s+default: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'",
        "#\\s+renovate-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned container image defaults in reusable workflow inputs",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "default: '(?<depName>docker\\.io/[^:']+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Versions annotated with a preceding '# renovate: datasource=... depName=...' comment",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w-]+: '?(?<currentValue>[^'\\s]+)'?"
      ]
    },
    {
      "customType": "regex",
      "description": "Version examples in the README",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "#\\s+reuse-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "Pins `reuse` (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "reuse",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Version examples in the README",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["#\\s+goreleaser-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "goreleaser/goreleaser",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Version examples in the README",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["#\\s+golangci-lint-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Container images for make lint-ci",
      "managerFilePatterns": ["/^Makefile\\.common$/"],
      "matchStrings": ["[A-Z_]+_IMAGE \\?= (?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "check-key-expiry.sh pinned to a gpg-signing-manager commit",
      "managerFilePatterns": ["/^actions/gpg-check-key-expiration/action\\.ya?ml$/"],
      "matchStrings": ["raw\\.githubusercontent\\.com/OpenCHAMI/gpg-signing-manager/(?<currentDigest>[a-f0-9]{40})/"],
      "depNameTemplate": "https://github.com/OpenCHAMI/gpg-signing-manager",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
